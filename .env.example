# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.

# Backend database (H2 file DB used locally by default — no config needed)
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/resumeiq;MODE=MySQL;AUTO_SERVER=TRUE
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# JWT secret (min 32 chars — generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# CORS — add your Vercel URL here when testing against a deployed frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# File storage
APP_STORAGE_DIRECTORY=./storage
APP_UPLOAD_MAX_SIZE=10MB

# AI provider: "mock" = local heuristic (no API key needed), "groq" = real LLM
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1

# ─── PRODUCTION (RENDER) ───────────────────────────────────────────────────────
# Set these in the Render dashboard → Environment:
#
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=<auto-filled by Render from the linked PostgreSQL service>
# JWT_SECRET=<generate a strong random value>
# APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# APP_STORAGE_DIRECTORY=/tmp/resumeiq-storage
#
# ─── PRODUCTION (VERCEL FRONTEND) ─────────────────────────────────────────────
# Set this in Vercel → Project Settings → Environment Variables:
#
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
