# Backend database (defaults to local H2 file DB when not set)
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/resumeiq;MODE=MySQL;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Storage
APP_STORAGE_DIRECTORY=./storage
APP_UPLOAD_MAX_SIZE=10MB

# AI provider: use "mock" for local heuristic mode, "groq" for real LLM analysis
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend
VITE_API_BASE_URL=/api/v1
